{
  "name": "hacksh",
  "version": "0.0.0",
  "description": "Type-safe command-line interfaces powered by Zod 4 schemas.",
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/kentrino/hacksh#readme",
  "bugs": {
    "url": "https://github.com/kentrino/hacksh/issues"
  },
  "license": "MIT",
  "author": "Kento Haneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentrino/hacksh.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "test:packed": "node scripts/test-packed-consumers.mjs",
    "ready": "vp run check && vp run test && vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.20.0"
}
